# Donate page. Set the options you use in .env.local or in your hosting settings.
# Production builds read these at build time. A new deployment applies changes.
# The page displays these receiving details publicly. Use only details intended for publication.

# Mongolian MNT account. All three fields are needed for the bank transfer option.
DONATE_MN_BANK=
DONATE_MN_RECIPIENT=
DONATE_MN_IBAN=
# Optional. Add the static merchant QR from QPay to public/donate and use its path, such as /donate/qpay.png.
DONATE_QPAY_QR=

# Kazakhstani KZT account. All three fields are needed for the bank transfer option.
DONATE_KZ_BANK=
DONATE_KZ_RECIPIENT=
DONATE_KZ_IBAN=
# Optional. Use the reusable HTTPS payment link issued by Kaspi Pay for your account.
DONATE_KASPI_URL=

# Add the public HTTPS pages for your approved creator accounts.
DONATE_GITHUB_SPONSORS_URL=
DONATE_KOFI_URL=
DONATE_PATREON_URL=

# Optional. Use your public HTTPS checkout after confirming eligibility with your provider.
DONATE_CRYPTO_URL=

# Legal pages. Set a public email address for private privacy and payment requests.
LEGAL_CONTACT_EMAIL=
# Optional HTTPS privacy notice for the production hosting provider.
LEGAL_HOST_PRIVACY_URL=
